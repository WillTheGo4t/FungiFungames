# ==========================================

# Line Endings Rules (Text Files)

# ==========================================



# Set default behavior to automatically normalize line endings

* text=auto



# Code and configuration files should strictly use LF in the repo

*.cpp text

*.h text

*.cs text

*.inl text

*.ini text

*.json text

*.txt text



# Unreal Specific Text Files (Neu hinzugefügt)

*.uproject text

*.uplugin text



# Scripts - Force Specific Line Endings (Neu hinzugefügt)

*.bat text eol=crlf

*.sh text eol=lf